  "devDependencies": { "@types/node": "22.0.0", "@types/react": "19.0.0", "@types/react-dom": "19.0.0", "esbuild": "0.25.0", "prettier": "3.9.10", "react": "19.0.0", "react-dom": "19.0.0", "typescript": "5.9.3" }
}
